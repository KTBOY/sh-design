{
  "name": "sh-design-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "description": "sh-design - A functional & business-oriented Vue 3 component library",
  "author": "shukezlc",
  "license": "MIT",
  "homepage": "https://ktboy.github.io/sh-design/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KTBOY/sh-design.git"
  },
  "bugs": {
    "url": "https://github.com/KTBOY/sh-design/issues"
  },
  "scripts": {
    "dev": "pnpm --filter @sh-design/play dev",
    "play": "pnpm --filter @sh-design/play dev",
    "build": "pnpm --filter sh-design build",
    "docs:dev": "pnpm --filter @sh-design/docs docs:dev",
    "docs:build": "pnpm --filter @sh-design/docs docs:build",
    "docs:preview": "pnpm --filter @sh-design/docs docs:preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,json,md}\"",
    "typecheck": "pnpm --filter sh-design typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.31.0",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
